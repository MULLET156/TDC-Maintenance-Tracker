# TDC Maintenance Tracker

# Always use HTTPS so the sign-in cookie stays private.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Dental Dashboard tiles: /tdc/tiles/<id> is answered by tiles.php.
# Pass the Authorization header through (some servers drop it otherwise).
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteRule ^tdc/tiles/([a-z-]+)/?$ tiles.php?id=$1 [L,QSA]

# Keep settings, the Git folder and project files private.
RewriteRule (^|/)\.git(/|$) - [F,L]
<FilesMatch "^(config\.php|config\.sample\.php|README\.md|\.gitignore|.*\.sql|.*\.sqlite)$">
  Require all denied
</FilesMatch>

# Install as an app (home screen): serve the manifest with the right type.
AddType application/manifest+json .webmanifest

Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
